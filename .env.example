DATABASE_URL=postgresql://user:password@host-pooler.region.aws.neon.tech/dbname?sslmode=require&channel_binding=require
API_PORT=3001

# Admin API token — required for POST /admin/:action endpoints
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN=change-me-to-a-random-64-char-hex-string

# Path to opencode auth.json (API keys for model testing)
GFM_AUTH_FILE=
# Path to opencode.jsonc (config with provider API key slots)
GFM_CONFIG_FILE=
# Discord/Slack webhook for nightly maintenance alerts
WEBHOOK_URL=
# Named alert channel for GrabFreeModels notifications
GRAB_FREE_MODELS_ALERTS=
